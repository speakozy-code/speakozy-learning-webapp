{
  "name": "speakozy-learning-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0 --port 3000",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 3000",
    "test": "node scripts/test-domain.mjs && node scripts/test-curriculum.mjs && node scripts/test-lesson-ui.mjs && node scripts/test-requested-material-ui.mjs && node scripts/test-drive-session-repairs.mjs && node scripts/test-pwa.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "firebase": "^11.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
